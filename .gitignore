# Secrets / env
.env
.env.*
*.pem
*.key
*secret*
*token*
*credential*
*credentials*
*senha*
*password*

# Backups / temporary
*.bak-*
.DS_Store
__pycache__/
*.pyc

# Archives and old inputs
99_ARQUIVO_MORTO/
*.zip

# Future local runtime
.runtime/
.cache/

# Keep inbox/reference folder structure, but do not commit user inputs or heavy references
00_COLE_AQUI/**
!00_COLE_AQUI/**/
!00_COLE_AQUI/**/.gitkeep

08_REFERENCIAS/**
!08_REFERENCIAS/**/
!08_REFERENCIAS/**/.gitkeep
# JARVIS volatile latest reports
07_RELATORIOS/02_TECNICOS/ULTIMO_*.md
# JARVIS tracked security scanner
!11_SCRIPTS/secret_scan.py

# Mission packs (generated by qa-sprint/goal-sprint/browser-qa/final-gate/claude-mission).
# Volatile by design — safety-gate must not fail just because a mission was generated.
# Use `git add -f` to persist a specific mission pack intentionally.
05_EXECUCAO/21_CLAUDE_MISSIONS/**
!05_EXECUCAO/21_CLAUDE_MISSIONS/.gitkeep

# Agent OS Sprint 3 — runtime data (NEVER committed during normal use).
# Task queue JSONL — append-only local task state.
05_EXECUCAO/34_TASKS/tasks.jsonl
# Run packages — created by `./jarvis go` each invocation; suprimível com
# --dry-run / --no-run-log / JARVIS_NO_REPORT=1.
05_EXECUCAO/35_RUNS/**
!05_EXECUCAO/35_RUNS/.gitkeep
# Blueprint outputs (local spec packages). Each blueprint is a timestamped
# folder under 40_BLUEPRINTS/; not committed unless intentional via `git add -f`.
05_EXECUCAO/40_BLUEPRINTS/2*/**
# Plans saved with `./jarvis plan ... --save`.
05_EXECUCAO/33_PLANS/2*.md

# Sprint 4 — work session runtime state.
05_EXECUCAO/36_WORK_SESSIONS/current.json
05_EXECUCAO/36_WORK_SESSIONS/events.jsonl

# Sprint 5 — gate runner runtime state.
05_EXECUCAO/37_GATES/latest.json
05_EXECUCAO/37_GATES/events.jsonl

# Sprint 6 — work session archive (state-archive --apply).
05_EXECUCAO/36_WORK_SESSIONS/archive/**
!05_EXECUCAO/36_WORK_SESSIONS/archive/.gitkeep

# Sprint 6 — no-claude offline packages.
05_EXECUCAO/38_NO_CLAUDE/**
!05_EXECUCAO/38_NO_CLAUDE/.gitkeep

# Sprint 6 — handoff snapshots (handoff-self --save).
05_EXECUCAO/39_HANDOFFS/**
!05_EXECUCAO/39_HANDOFFS/.gitkeep

# Sprint 7 — release candidate snapshots (rc-freeze --apply).
05_EXECUCAO/41_RELEASE_CANDIDATES/**
!05_EXECUCAO/41_RELEASE_CANDIDATES/.gitkeep
