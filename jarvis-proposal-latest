#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"

latest() {
  find "$1" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | tail -1
}

client=$(latest "05_EXECUCAO/50_CLIENT_KITS")
sell=$(latest "05_EXECUCAO/48_SELL_KITS")

OUT="05_EXECUCAO/53_PROPOSAL_PAGES"
mkdir -p "$OUT"

ts=$(date +"%Y-%m-%d_%H-%M-%S")
dir="$OUT/${ts}_proposal"
mkdir -p "$dir"

proposta=""
mensagem=""
preco=""
escopo=""

[ -f "$client/01_PROPOSTA.md" ] && proposta=$(cat "$client/01_PROPOSTA.md")
[ -f "$client/03_MENSAGEM_CLIENTE.md" ] && mensagem=$(cat "$client/03_MENSAGEM_CLIENTE.md")
[ -f "$sell/03_PRECO.md" ] && preco=$(cat "$sell/03_PRECO.md")
[ -f "$sell/04_ESCOPO.md" ] && escopo=$(cat "$sell/04_ESCOPO.md")

cat > "$dir/index.html" <<EOF
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Proposta JARVIS</title>
<style>
body{font-family:Arial;background:#0f172a;color:#f8fafc;margin:0;padding:40px}
.wrap{max-width:950px;margin:auto}
.hero{background:#111827;border:1px solid #334155;border-radius:24px;padding:34px;margin-bottom:22px}
.card{background:#020617;border:1px solid #334155;border-radius:18px;padding:24px;margin:18px 0}
h1{font-size:44px;margin:0 0 10px}
h2{font-size:25px;color:#38bdf8}
pre{white-space:pre-wrap;font-family:Arial;line-height:1.55;color:#e5e7eb}
.badge{display:inline-block;background:#1e293b;padding:8px 12px;border-radius:999px;color:#93c5fd}
</style>
</head>
<body>
<div class="wrap">
  <div class="hero">
    <span class="badge">Proposta gerada pelo JARVIS</span>
    <h1>Proposta de Automação</h1>
    <p>Pacote inicial para validar ideia, mostrar demo e transformar em entrega vendável.</p>
  </div>

  <div class="card">
    <h2>Proposta</h2>
    <pre>$proposta</pre>
  </div>

  <div class="card">
    <h2>Mensagem para cliente</h2>
    <pre>$mensagem</pre>
  </div>

  <div class="card">
    <h2>Preço</h2>
    <pre>$preco</pre>
  </div>

  <div class="card">
    <h2>Escopo</h2>
    <pre>$escopo</pre>
  </div>
</div>
</body>
</html>
EOF

echo "PROPOSAL_LATEST_OK"
echo "pasta: $dir"
echo "abrir: open $dir/index.html"
open "$dir/index.html"
